# WeatherGPT Backend — Environment Variables
# Copy this file to .env and adjust values as needed.

APP_NAME=WeatherGPT
APP_VERSION=0.1.0
DEBUG=false

HOST=0.0.0.0
PORT=8000

# CORS origins (comma-separated if overriding default list)
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5500"]

# Open-Meteo (no API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
WEATHER_REQUEST_TIMEOUT=10

# Popular cities shown on the dashboard sidebar
POPULAR_CITIES=["Phagwara","Delhi","Mumbai","Bengaluru"]
